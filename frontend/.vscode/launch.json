{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend: Next.js (dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(https?://localhost:[0-9]+)"
      }
    }
  ]
}
